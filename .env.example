# --- auth: one key per client, comma separated ---
API_KEYS=change-me-client-a,change-me-client-b

# --- infra ---
REDIS_URL=redis://redis:6379/0
JOB_TIMEOUT_SECONDS=900

# --- google drive (Shared Drive) ---
GOOGLE_CREDENTIALS_FILE=/secrets/service-account.json
DRIVE_INPUT_FOLDER_ID=
DRIVE_OUTPUT_FOLDER_ID=
DRIVE_SHARED_DRIVE_ID=

# --- ocr ---
OCR_LANG=fr
OCR_DPI=220
MAX_PAGES=15
MIN_TEXT_CHARS=200
MIN_BLOCK_SCORE=0.6

# --- self-contained mode: watch the input folder, no external trigger ---
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=120
